# REQUIRED       the server refuses to start without it.
# PIXEL MARKET   optional for the server, but required for the Pixel Market launch (set them together).
# OPTIONAL       has a working default, or leaves a feature off when unset.

# ── RPC ──
# REQUIRED: RPC_URL (at least one URL). OPTIONAL: up to two fallbacks.
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_URL_FALLBACK_1=
RPC_URL_FALLBACK_2=
# OPTIONAL (default 1). Use 31337 when RPC_URL is a local Anvil mainnet fork.
CHAIN_ID=1

# ── Indexer ──
# REQUIRED: the Ponder indexer's API.
PONDER_API_URL=http://localhost:42069
# OPTIONAL: shared secret sent to the private Ponder reverse proxy.
PONDER_API_SECRET=

# ── Server ──
# OPTIONAL (default 3000).
PORT=3000
# OPTIONAL (default https://api.normies.art): public host, used for absolute URLs in /agents/metadata.
PUBLIC_API_BASE=https://api.normies.art
# OPTIONAL (default 60): requests per minute per IP.
RATE_LIMIT_MAX=60
# OPTIONAL (unset = no bypass): requests sending this as x-internal-secret skip the rate limit.
INTERNAL_SECRET=
# OPTIONAL (unset = admin routes off): key for PUT /rarity/admin/*. RARITY_ADMIN_KEY is also accepted.
ADMIN_KEY=

# ── OpenSea ──
# OPTIONAL (unset = no OpenSea listing data in /rarity).
OPENSEA_API_KEY=
# OPTIONAL (default normies).
OPENSEA_COLLECTION_SLUG=normies
# OPTIONAL (default 3): refreshes a token must be missing from OpenSea before its listing is dropped.
LISTING_REMOVAL_GRACE=3

# ── Original canvas (V1) ──
# OPTIONAL: default to the mainnet contracts; kept for history after the Pixel Market cutover.
CANVAS_ADDRESS=0x64951d92e345C50381267380e2975f66810E869c
CANVAS_STORAGE_ADDRESS=0xC255BE0983776BAB027a156681b6925cde47B2D1

# ── Zombies and Legendary Canvas ──
# OPTIONAL: set ZOMBIE_ADDRESS and ZOMBIE_STORAGE_ADDRESS together to enable zombie-aware rendering
# (in production, set all four).
ZOMBIE_ADDRESS=
ZOMBIE_STORAGE_ADDRESS=
ZOMBIE_RENDERER_ADDRESS=
# OPTIONAL (unset = no Legendary Canvas trait or routes).
LEGENDARY_CANVAS_ADDRESS=

# ── Pixel Market ──
# PIXEL MARKET: all three together enable /pixels, /market, canvas sinks and the grid-aware canvas status.
CANVAS_V2_ADDRESS=
CANVAS_STORAGE_V2_ADDRESS=
MARKET_ADDRESS=

# ── Revenue share (needs the Pixel Market three above) ──
# PIXEL MARKET: unset pool = revenue share routes off.
REVENUE_POOL_ADDRESS=
# PIXEL MARKET: shown in /revshare/status and kept out of the holder scoring.
ROYALTY_SPLITTER_ADDRESS=
# OPTIONAL (default data/revshare): where epoch files (payouts and proofs) are read from.
REVSHARE_DIR=data/revshare

# ── Cache TTLs in milliseconds (all OPTIONAL; the values below are the defaults) ──
CACHE_MAX_ENTRIES=10000
CACHE_TTL_MS=3600000
CANVAS_CACHE_TTL_MS=60000
CANVAS_INFO_CACHE_TTL_MS=60000
CANVAS_STATUS_CACHE_TTL_MS=300000
ZOMBIE_CACHE_TTL_MS=60000
ZOMBIE_STATUS_CACHE_TTL_MS=10000
LEGENDARY_CANVAS_CACHE_TTL_MS=60000
RARITY_CACHE_TTL_MS=60000
RARITY_LISTINGS_REFRESH_MS=60000
MARKET_CACHE_TTL_MS=10000
