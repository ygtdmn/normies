{
    "name": "normies-api",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc && cp -r src/content dist/content",
        "start": "node dist/index.js",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "revshare": "tsx src/revshare/cli.ts",
        "cutover:delegations": "tsx src/cutover/migrate-delegations.ts"
    },
    "dependencies": {
        "@hono/node-server": "^2.1.5",
        "@openzeppelin/merkle-tree": "^1.0.8",
        "@resvg/resvg-js": "^2.6.2",
        "dotenv": "^18.0.8",
        "hono": "^4.13.13",
        "lru-cache": "^11.5.3",
        "viem": "^2.57.8"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3",
        "undici-types": ">=7.24.0 <7.24.7",
        "vitest": "^5.0.5"
    },
    "packageManager": "pnpm@10.34.7"
}
