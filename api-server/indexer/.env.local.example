# REQUIRED   the indexer refuses to start without it (ponder.config.ts requiredEnv).
# OPTIONAL   has a fallback; every optional start block falls back to PONDER_START_BLOCK.

# ── Chain and database ──
# REQUIRED.
PONDER_RPC_URL=
# REQUIRED: 1 (mainnet), 11155111 (Sepolia) or 31337 (Anvil).
PONDER_CHAIN_ID=
# REQUIRED: the default start block for every contract below.
PONDER_START_BLOCK=
# REQUIRED in production: Postgres. Without it Ponder uses a local PGlite database, and the rarity
# admin config (PUT /rarity/admin/*) cannot be stored.
DATABASE_URL=

# ── Collection ──
# REQUIRED.
PONDER_NORMIES_ADDRESS=
# REQUIRED.
PONDER_MINTER_V2_ADDRESS=0xc513272597d3022D77b3d7EEBA92cea5D7fb2808
# OPTIONAL: first block for the minter.
PONDER_MINTER_START_BLOCK=
# OPTIONAL: stop indexing the minter here (it is exhausted, so nothing new arrives).
PONDER_MINTER_END_BLOCK=

# ── Original canvas (V1), kept for history ──
# REQUIRED.
PONDER_CANVAS_ADDRESS=
# OPTIONAL: first block for the original canvas.
PONDER_CANVAS_START_BLOCK=
# REQUIRED: indexed for direct setTransformedImageData calls (traces), so writes that bypass the canvas
# still land in history.
PONDER_CANVAS_STORAGE_ADDRESS=
# OPTIONAL: first block for the storage trace backfill (the first direct-write block avoids a long scan).
PONDER_CANVAS_STORAGE_START_BLOCK=
# OPTIONAL (default true): set to false where the RPC has no trace API; direct V1 storage writes are then missed.
PONDER_CANVAS_STORAGE_TRACES=true

# ── Agents ──
# REQUIRED.
PONDER_ADAPTER_ADDRESS=
# OPTIONAL: the Adapter8004 deploy block avoids scanning empty history.
PONDER_ADAPTER_START_BLOCK=

# ── Zombies and Legendary Canvas ──
# REQUIRED.
PONDER_ZOMBIE_ADDRESS=
PONDER_ZOMBIE_STORAGE_ADDRESS=
# OPTIONAL: first blocks for the zombie contracts (storage falls back to the zombie start block first).
PONDER_ZOMBIE_START_BLOCK=
PONDER_ZOMBIE_STORAGE_START_BLOCK=
# REQUIRED.
PONDER_LEGENDARY_CANVAS_ADDRESS=
# OPTIONAL: first block for the Legendary Canvas registry.
PONDER_LEGENDARY_CANVAS_START_BLOCK=

# ── Pixel Market (all five REQUIRED) ──
# The V1 canvas and storage above stay configured for history; V2 events replace the V1 call-trace workaround.
PONDER_CANVAS_V2_ADDRESS=
PONDER_CANVAS_STORAGE_V2_ADDRESS=
PONDER_MARKET_ADDRESS=
PONDER_REVENUE_POOL_ADDRESS=
PONDER_ROYALTY_SPLITTER_ADDRESS=
# OPTIONAL but set it: the Pixel Market deploy block (26122420 on mainnet), shared by the five contracts above.
PONDER_PIXEL_MARKET_START_BLOCK=
