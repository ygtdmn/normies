# /etc/normies/revshare.env  (chmod 600, owned by root; systemd reads it for the service user)

# Archive node: the scorer reads balances at sampled historical blocks.
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/KEY
# Required: a second, independent provider (not the same endpoint as RPC_URL). The epoch is rebuilt there from
# scratch and must match exactly before it is posted; the job refuses to post without it.
RPC_URL_VERIFY=https://lb.drpc.live/ethereum/KEY
CHAIN_ID=1

# Pixel Market stack (mainnet, deployed at block 26122420)
CANVAS_V2_ADDRESS=0xF14f2852e1fD6A4108156054AF49B3915dc40E2e
CANVAS_STORAGE_V2_ADDRESS=0x96F2DA32Bb9D429d59ac13dB469f4950cBe02084
MARKET_ADDRESS=0x86156A8d6e4B9925F7fEca527ea5D71B0deeDB64
REVENUE_POOL_ADDRESS=0x481384812e79bf0d11FC0b1704af445D5F06813c
ROYALTY_SPLITTER_ADDRESS=0xA68A225f62772E6158f2B5f8afC184AdB69c3282

# The revshare poster: a gas-only key holding the pool's POSTER role and nothing else (REVSHARE_POSTER in
# HandoffOwnership.s.sol). It calls the permissionless release() and unwrap() and posts epochs; claims open 24 hours
# after each post, so the Operations Safe can cancel a bad one. Never an owner or Safe key.
PRIVATE_KEY=0x

# Where epoch files are written. Caddy serves REVSHARE_DIR/epochs on this host at /revshare-epochs/ (Caddyfile.snippet),
# the API fetches them with the indexer secret and serves them publicly at REVSHARE_PUBLIC_URL/<id>.json, and that
# public URL is each epoch's on-chain dataURI. A run checks it serves the new file before it posts.
REVSHARE_DIR=/var/lib/normies-revshare
REVSHARE_PUBLIC_URL=https://api.normies.art/revshare/files

# true: a run builds, verifies and publishes the epoch, then waits for a person to post it
# (sudo /opt/normies/deploy/revshare/revshare.sh approve <id>); Discord is paged until then. false: posts by itself.
REVSHARE_REQUIRE_APPROVAL=true

# First epoch only: the block the market went live at. Later epochs start where the previous one ended.
REVSHARE_GENESIS_BLOCK=26127870
# Blocks kept back from the head so a reorg cannot change a posted root (64 is about 13 minutes).
EPOCH_FINALITY_BLOCKS=64
# The job refuses to post an epoch shorter than this (about 23 hours) or while the previous epoch has not opened.
MIN_EPOCH_BLOCKS=7000
