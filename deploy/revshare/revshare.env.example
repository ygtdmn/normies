# /etc/normies/revshare.env  (chmod 600, owned by root, readable by the service user through EnvironmentFile)

# Archive node: the scorer reads balances at sampled historical blocks.
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/KEY
# Required: a second, independent provider (not the same endpoint as RPC_URL). The epoch is rebuilt there from
# scratch and must match exactly before it is posted; the job refuses to post without it.
RPC_URL_VERIFY=https://lb.drpc.live/ethereum/KEY
CHAIN_ID=1

# Pixel Market stack (published at deployment)
CANVAS_V2_ADDRESS=0x
CANVAS_STORAGE_V2_ADDRESS=0x
MARKET_ADDRESS=0x
REVENUE_POOL_ADDRESS=0x
ROYALTY_SPLITTER_ADDRESS=0x

# The pool owner. postEpoch is owner-only, so this key IS the pool owner: keep the machine locked down and the
# key funded with gas only. Nothing else on the server needs it.
PRIVATE_KEY=0x

# Where epoch files are written. The API server serves this directory (REVSHARE_DIR in its own env), so both
# must point at the same place on this machine.
REVSHARE_DIR=/opt/normies/smart-contracts/api-server/data/revshare
# Public base of the epoch files; becomes each epoch's on-chain dataURI.
REVSHARE_PUBLIC_URL=https://api.normies.art/revshare/epochs

# First epoch only: the block the market went live at. Later epochs start where the previous one ended.
REVSHARE_GENESIS_BLOCK=
# Blocks kept back from the head so a reorg cannot change a posted root (64 is about 13 minutes).
EPOCH_FINALITY_BLOCKS=64
# The job refuses to post an epoch shorter than this (about a day), so a second run in a month does nothing.
MIN_EPOCH_BLOCKS=7000
