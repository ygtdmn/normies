# /etc/normies/revshare-alert.env  (chmod 600, owned by root). Separate from revshare.env so the alert unit never
# loads the poster key.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN
# Optional: who to ping, e.g. <@123456789012345678> for a user or <@&ROLE_ID> for a role.
DISCORD_MENTION=
