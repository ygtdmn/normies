# Posts one revenue share epoch: releases the royalty splitter, unwraps the pool's WETH, builds the epoch
# from chain state, verifies it against a second RPC, writes the epoch file to REVSHARE_DIR (served publicly by
# Caddy, see Caddyfile.snippet) and posts the Merkle root from the POSTER key (claims open 24 hours later).
# Triggered by normies-revshare.timer; safe to start by hand. Every run ends in a Discord message
# (normies-revshare-alert@.service): failures and "action needed" (exit code 2) as alerts.
[Unit]
Description=Normies revenue share epoch
After=network-online.target
Wants=network-online.target
OnFailure=normies-revshare-alert@%N.service
OnSuccess=normies-revshare-alert@%N.service

[Service]
Type=oneshot
User=normies
Group=normies
WorkingDirectory=/opt/normies/api-server
EnvironmentFile=/etc/normies/revshare.env
ExecStart=/opt/normies/api-server/node_modules/.bin/tsx src/revshare/cli.ts run
# A month of chain data through an archive RPC can take a while; the finality wait adds up to fifteen minutes.
TimeoutStartSec=4h
Nice=10
StandardOutput=journal
StandardError=journal
# /var/lib/normies-revshare: epoch files (world-readable, Caddy serves epochs/) and Safe proposals.
StateDirectory=normies-revshare
StateDirectoryMode=0755
UMask=0022
# Hardening: the job needs the repo, its state directory and the network, nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
