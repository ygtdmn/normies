# /etc/normies/watcher.env  (chmod 600, owned by root)
RPC_URL=https://eth-mainnet.g.alchemy.com/v2/KEY
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/ID/TOKEN
# Who urgent messages ping, e.g. <@123456789012345678> (a user) or <@&ROLE_ID> (a role). Empty: no ping.
DISCORD_MENTION=
# Optional: blocks behind the head (3), seconds between polls (30)
CONFIRMATIONS=3
POLL_SECONDS=30
